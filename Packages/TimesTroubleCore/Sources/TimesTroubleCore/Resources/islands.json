   "id": "hollow",
   "name": "Hatchling Hollow",
   "tagline": "Eggs, nests and one very fussy mum",
   "focus": "Warm-up tables",
   "colour": "#7BC86C",
   "roar": 1,
   "part": "cog",
   "partName": "Cog",
   "ready": true,
   "guardian": {
    "name": "Mama Maia",
    "kind": "maia",
    "phases": [
     "g:Shoo! Shoo! Nobody touches my shiny egg!",
     "g:Still here? Oh, my poor nerves! Off you go, you little rascals!",
     "g:Wait. Since when do eggs go tick-tock?"
    ],
    "befriended": [
     "o:Mama Maia, it isn't an egg. It's the Cog from our time machine!",
     "g:Oh my. Oh dear. I've been keeping a cog warm all week!",
     "g:Here, take it, dears. And come back when my real babies hatch!"
    ]
   },
   "levels": [
    {
     "id": "hollow-1",
     "title": "Egg Hatch",
     "mode": "eggRescue",
     "skills": [
      "multiplication"
     ],
     "count": 6,
     "intro": [
      "m:Look at all these eggs, Otter. They're about to hatch!",
      "o:Answer the sums and they'll pop open!",
      "m:Gently. They're only babies."
     ],
     "outro": [
      "o:Baby dinosaurs! They think I'm their mum.",
      "m:You do have the right hair."
     ],
     "reward": "pet-pip",
     "blurb": "Hatch the baby dinosaurs"
    },
    {
     "id": "hollow-2",
     "title": "Fern Dash",
     "mode": "dinoDash",
     "skills": [
      "multiplication"
     ],
     "count": 8,
     "intro": [
      "g:HONK! Who's that sniffing round my nest?",
      "o:Run, Mosey! Pick the path with the right answer!",
      "m:Right answers make us faster. Go, go, go!"
     ],
     "outro": [
      "o:We lost her! I think.",
      "m:She's gone back to sit on something shiny."
     ],
     "reward": "hat-goggles",
     "blurb": "Dash through the ferns"
    },
    {
     "id": "hollow-3",
     "title": "Stepping Stones",
     "mode": "bridgeBuilder",
     "skills": [
      "multiplication",
      "sequences"
     ],
     "count": 6,
     "intro": [
      "m:This stream is too fast to swim, even for me.",
      "o:Then we'll hop across on the stones with the right numbers!",
      "m:Count carefully. Splashing is not a plan."
     ],
     "outro": [
      "o:Dry feet! Well, mostly."
     ],
     "reward": "deco-campfire",
     "blurb": "Hop across the stream"
    },
    {
     "id": "hollow-4",
     "title": "Tiptoe Past",
     "mode": "tiptoe",
     "skills": [
      "multiplication",
      "missingNumber"
     ],
     "count": 8,
     "intro": [
      "o:Shh! Mama Maia is fast asleep on her nest.",
      "m:And look what she's sitting on. Our Cog!",
      "o:Each right answer is one tiptoe closer. Quietly!"
     ],
     "outro": [
      "m:She's sitting right on top of it.",
      "o:Then we'll have to be brave. And quick."
     ],
     "reward": "pet-nubbin",
     "blurb": "Sneak past a sleeping dinosaur"
    },
    {
     "id": "hollow-5",
     "title": "Mama Maia",
     "mode": "guardian",
     "skills": [
      "multiplication",
      "missingNumber"
     ],
     "count": 9,
     "intro": [
      "g:HONK! You again! Stay away from my shiny egg!",
      "o:It's not an egg! It's part of our time machine!",
      "m:Answer quickly, Otter. Here she comes!"
     ],
     "outro": [
      "o:One part back. Five to go!",
      "m:And not a single egg was harmed."
     ],
     "reward": null,
     "blurb": "Escape Mama Maia and win back the Cog"
    }
